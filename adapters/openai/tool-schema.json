{
  "name": "shap_review",
  "version": "0.0.0.dev0",
  "schema_version": "2",
  "description": "Evidence-driven SHAP repository review engine.",
  "commands": [
    "map",
    "health",
    "analyze",
    "report",
    "hotspots",
    "explore",
    "investigate",
    "reproduce",
    "fuzz",
    "fuzz-treeexplainer",
    "fuzz-protocol",
    "fuzz-backends",
    "differential",
    "cpu-gpu-differential",
    "regressions",
    "history",
    "sanitizer",
    "differential-versions",
    "evidence",
    "semantic-oracle",
    "native-map",
    "api-era",
    "capabilities",
    "version"
  ],
  "input": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "description": "The toolkit command to execute."
      },
      "arguments": {
        "type": "object",
        "additionalProperties": true,
        "description": "Command-specific keyword arguments."
      }
    },
    "required": [
      "command"
    ]
  },
  "output": {
    "type": "object",
    "required": [
      "provider",
      "schema_version",
      "command"
    ],
    "properties": {
      "provider": { "type": "string" },
      "version": { "type": "string" },
      "schema_version": { "type": "string" },
      "command": { "type": "string" },
      "result": { "type": "object", "description": "Present on success." },
      "error": { "type": "object", "description": "Present on failure; contains kind, message, command, layer." }
    }
  },
  "script_execution_commands": [
    "differential",
    "cpu-gpu-differential",
    "differential-versions",
    "reproduce",
    "sanitizer"
  ],
  "security_note": "Commands in script_execution_commands execute arbitrary Python scripts via subprocess. Only invoke with trusted, controlled input paths.",
  "evidence_model": {
    "name": "EvidenceChain",
    "schema_version": "2",
    "independence_tracking": true,
    "independent_evidence_required_for_confirmation": true,
    "verdicts": [
      "UNVALIDATED",
      "STATIC_CANDIDATE",
      "HISTORICALLY_CORRELATED",
      "DYNAMICALLY_VALIDATED",
      "HIGH_CONFIDENCE",
      "CONFIRMED",
      "SANITIZER_FINDING",
      "SANITIZER_CLEAN"
    ],
    "dynamic_evidence_note": "The 'analyze' command runs a bounded TreeExplainer campaign against the installed SHAP runtime, not the repository under review. The runtime-bridge.json artifact records anomalies but those anomalies do not currently enrich candidate evidence chains because the generic bridge campaign does not set per-candidate fingerprints."
  }
}
